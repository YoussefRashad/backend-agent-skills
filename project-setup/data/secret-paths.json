{
  "$comment": "Secret-path defaults. Rendered controls use the effective project policy. Secret scanning includes protected paths and labels findings; it does not exclude them.",
  "schema": 1,
  "patterns": [
    {
      "glob": "**/.env*",
      "kind": "env",
      "note": "Includes .env.example. Agents never read any .env* file; scripts/env-keys.mjs extracts key NAMES only."
    },
    {
      "glob": "**/*.pem",
      "kind": "key"
    },
    {
      "glob": "**/*.key",
      "kind": "key"
    },
    {
      "glob": "**/*.p12",
      "kind": "key"
    },
    {
      "glob": "**/*.pfx",
      "kind": "key"
    },
    {
      "glob": "**/*.crt",
      "kind": "cert"
    },
    {
      "glob": "**/*.cer",
      "kind": "cert"
    },
    {
      "glob": "**/*.cert",
      "kind": "cert"
    },
    {
      "glob": "**/*.jks",
      "kind": "key"
    },
    {
      "glob": "**/*.keystore",
      "kind": "key"
    },
    {
      "glob": "**/id_rsa*",
      "kind": "key"
    },
    {
      "glob": "**/id_ed25519*",
      "kind": "key"
    },
    {
      "glob": "**/secrets/**",
      "kind": "dir"
    },
    {
      "glob": "**/credentials/**",
      "kind": "dir"
    },
    {
      "glob": "**/.aws/**",
      "kind": "dir"
    },
    {
      "glob": "**/.ssh/**",
      "kind": "dir"
    },
    {
      "glob": "**/.gnupg/**",
      "kind": "dir"
    },
    {
      "glob": "**/.npmrc",
      "kind": "token",
      "note": "Often holds registry auth tokens."
    },
    {
      "glob": "**/.htpasswd",
      "kind": "credential"
    },
    {
      "glob": "**/.ai/.run/*/vault/**",
      "kind": "staging",
      "note": "Script-only area: backups and merged .env.example may contain real values. Agents never read it."
    }
  ],
  "contentRisk": {
    "$comment": "Readable, but may embed real values. Agents may read structure; they must never reproduce values from these files in outputs or reports.",
    "globs": [
      "**/docker-compose*.yml",
      "**/docker-compose*.yaml",
      "**/*.config.ts",
      "**/*.config.js",
      "**/ormconfig*",
      "**/k8s/**",
      "**/helm/**"
    ]
  },
  "codexGlobScanMaxDepth": 6
}
